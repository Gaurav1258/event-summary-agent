# ---------------------------------------------------------
# GCP Configuration
# ---------------------------------------------------------
GCP_PROJECT_ID=your-project-id-here
GCP_REGION=us-central1

# Only required if running locally without `gcloud auth application-default login`
# Put the actual JSON file in a safe place (like a `/secrets` folder which is gitignored)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-sa-key.json

# ---------------------------------------------------------
# Dataset Credentials (For Phase 1.5 Data Fetching)
# ---------------------------------------------------------
HF_TOKEN=your-huggingface-token-here
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-key
